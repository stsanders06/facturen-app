# Kopieer dit bestand naar .env en pas aan wat je wilt.
# Mailinstellingen, bedrijfsgegevens en je wachtwoord staan niet hier: die
# zet je in de app zelf (Instellingen) en ze staan in data/facturen.db.

# De poort op de Pi. Open de app op http://<adres-van-de-pi>:8099
POORT=8099

# Alleen op één adres van de Pi luisteren, bijvoorbeeld 192.168.1.20 (alleen
# het thuisnetwerk) of 127.0.0.1 (alleen de Pi zelf, achter een reverse proxy).
# Leeg = alle netwerken van de Pi. Let op: ufw houdt een Docker-poort NIET
# tegen; Docker zet zijn eigen regels ervóór. Zie DOCKER.md.
LUISTER_ADRES=

# Tijdzone voor factuurdatums, "te laat" en het jaar in het nummer.
TZ=Europe/Amsterdam

# Hoeveel de app in de log zet: debug, info, warning of error.
LOG_LEVEL=info

# De gebruiker op de Pi die eigenaar wordt van de map data: zet hier wat
# id -u en id -g zeggen. Dan kun je zelf zonder sudo bij de back-up.
# 0 (root) weigert de app.
PUID=1000
PGID=1000

# 1 als je de app alleen via https opent (reverse proxy of Tailscale). Over
# gewoon http://<pi>:8099 moet dit 0 blijven, anders kom je niet meer binnen.
SESSION_COOKIE_SECURE=0

# De bonnenlezer. Leeg = scans worden niet automatisch gelezen; je vult de bon
# dan zelf in, net als voor 2.2.0. Laat dit staan zoals het is om hem te
# gebruiken; uitzetten kan ook met de schakelaar in Instellingen.
BON_OCR_URL=http://bon-ocr:8099/lees

# Hoe lang de app op de lezer wacht, in seconden. Op een Pi 5 duurt een bon
# een paar seconden; dit is een achtergrondtaak, dus ruim mag.
BON_OCR_TIJD=30

# Hoeveel kernen de lezer mag gebruiken. De Pi 5 heeft vier.
OCR_DRADEN=4
